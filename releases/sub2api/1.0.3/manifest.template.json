  "deployment": {
    "allowed_modes": [
      "manual",
      "systemd"
    ],
    "build_steps": [
      {
        "kind": "pnpm-install",
        "workdir": "frontend"
      },
      {
        "kind": "pnpm-build",
        "workdir": "frontend"
      },
      {
        "kind": "go-build-server",
        "workdir": "backend"
      }
    ],
    "systemd": {
      "service": "sub2api"
    },
    "health": {
      "url": "http://127.0.0.1:8080/health",
      "timeout_seconds": 30
    },
    "manual_steps": [
      "在 frontend 运行 pnpm install --frozen-lockfile \u0026\u0026 pnpm build",
      "在 backend 运行 go test ./internal/hamsteryaml ./internal/handler/hamstertutorial ./internal/service ./internal/handler ./internal/server/routes",
      "在 backend 运行 go build -o ../sub2api ./cmd/server",
      "按本站部署方式重启 sub2api，并检查 /health"
    ]
  },
  "impact_notes": [
    {
      "kind": "breaking",
      "message": "旧 hs_ 签名 URL 和无 /api 兼容 URL 立即失效；升级不会静默删除旧开发期 API Key。"
    },
    {
      "kind": "database",
      "message": "新增配置订阅、YAML 模板版本、教程覆盖/候选和图片元数据表。"
    },
    {
      "kind": "security",
      "message": "教程更新只读取独立签名信任根的正式 Release；外链图片由服务器执行 SSRF 防护和内容校验后缓存。"
    },
    {
      "kind": "content",
      "message": "通用教程正文后续由维护者发布；站点覆盖内容和冲突处理不会被自动覆盖。"
    }
  ]
}
