  "deployment": {
    "allowed_modes": [
      "manual",
      "systemd"
    ],
    "build_steps": [
      {
        "kind": "pnpm-install",
        "workdir": "frontend"
      },
      {
        "kind": "pnpm-build",
        "workdir": "frontend"
      },
      {
        "kind": "go-build-server",
        "workdir": "backend"
      }
    ],
    "systemd": {
      "service": "sub2api"
    },
    "health": {
      "url": "http://127.0.0.1:8080/health",
      "timeout_seconds": 30
    },
    "manual_steps": [
      "在 frontend 运行 pnpm install --frozen-lockfile \u0026\u0026 pnpm build",
      "在 backend 运行 go test ./internal/hamsteryaml ./internal/handler/hamstertutorial ./internal/service ./internal/handler ./internal/server/routes",
      "在 backend 运行 go build -o ../sub2api ./cmd/server",
      "按本站部署方式重启 sub2api，并检查 /health"
    ]
  },
  "impact_notes": [
    {
      "kind": "fix",
      "message": "正式配置订阅中的每个 provider 默认携带对应分组的 rate_multiplier，管理员 pricing 覆盖仍按字段合并。"
    },
    {
      "kind": "database",
      "message": "仅将仍等于旧内置默认值的启用模板升级为支持 description、icon、pricing 和 settings_config 的当前模板；自定义模板和非启用历史版本保持不变。"
    },
    {
      "kind": "breaking",
      "message": "旧 hs_ 签名 URL 和无 /api 兼容 URL 立即失效；升级不会静默删除旧开发期 API Key。"
    },
    {
      "kind": "database",
      "message": "新增配置订阅、YAML 模板版本、教程覆盖/候选和图片元数据表。"
    },
    {
      "kind": "security",
      "message": "教程更新只读取独立签名信任根的正式 Release；外链图片由服务器执行 SSRF 防护和内容校验后缓存。"
    },
    {
      "kind": "content",
      "message": "通用教程正文后续由维护者发布；站点覆盖内容和冲突处理不会被自动覆盖。"
    },
    {
      "kind": "security",
      "message": "普通用户不再通过登录态管理接口查看原始 YAML；管理员预览保留审计日志，公共 hsc_ 订阅 URL 保持可用。"
    },
    {
      "kind": "database",
      "message": "模板草稿与版本新增 presentation JSON，并新增隐藏订阅专用 API 密钥的站点设置和查询索引。"
    },
    {
      "kind": "content",
      "message": "订阅模板管理页升级为中英文、主题自适应的订阅配置与分组配置界面；字段聚焦后会填入动态默认值，方便直接修改。"
    },
    {
      "kind": "content",
      "message": "Provider 结构化配置与当前 YAML token 对齐，settings_config 支持安全 JSON 编辑，预览和订阅下载严格转义内联 JSON。"
    },
    {
      "kind": "fix",
      "message": "Provider 仅开放 name、description、icon、base_url、pricing、settings_config；base_url 与 settings_config 中的请求端点双向同步。"
    },
    {
      "kind": "fix",
      "message": "缺少模型映射的分组在模板预览中静默跳过，不再显示 GROUP_PREVIEW_SKIPPED 诊断。"
    },
    {
      "kind": "fix",
      "message": "模板分组 pricing 默认读取 groups.rate_multiplier，并提供可编辑的 pricing.multiplier；旧 pricing 覆盖会保留默认倍率。"
    },
    {
      "kind": "database",
      "message": "仅迁移仍等于旧内置默认值的模板草稿，为其补齐 provider description、icon、pricing 和 settings_config；管理员自定义草稿保持不变。"
    },
    {
      "kind": "fix",
      "message": "模板编辑器改用 Vue 可追踪的动态字段判断；点击空白输入框后会立即填入名称、图标、默认倍率和严格 JSON 配置，便于直接修改。"
    },
    {
      "kind": "operations",
      "message": "预构建镜像安装器支持识别自定义 sub2api 镜像和重命名的 Compose 服务，并允许通过 --compose-file 与 --service 显式选择。"
    }
  ]
}
