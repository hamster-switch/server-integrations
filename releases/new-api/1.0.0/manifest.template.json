    "systemd": {
      "service": "new-api"
    },
    "health": {
      "url": "http://127.0.0.1:3000/api/status",
      "timeout_seconds": 30
    },
    "manual_steps": [
      "在 web 目录运行 bun install --frozen-lockfile",
      "分别在 web/default 与 web/classic 运行 bun run build",
      "在项目根目录运行 go test ./controller ./model ./router ./service/hamsterswitch",
      "在项目根目录运行 go build -o new-api .",
      "按本站部署方式重启 new-api，并检查 /api/status"
    ]
  },
  "impact_notes": [
    {
      "kind": "breaking",
      "message": "旧 hs_ 签名 URL 立即失效；升级不会按名称自动删除开发期 Token。"
    },
    {
      "kind": "database",
      "message": "新增配置订阅、YAML 模板版本、教程快照、站点覆盖与图片元数据表。"
    },
    {
      "kind": "security",
      "message": "教程仅从正式签名 Release 更新，外链图片经服务端 SSRF 防护、内容校验与缓存。"
    },
    {
      "kind": "content",
      "message": "通用教程正文由维护者后续发布；站点定制内容与逐项冲突决议不会被自动覆盖。"
    }
  ]
